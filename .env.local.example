# Copy to .env.local and fill in real values. Never commit .env.local.
# Vercel Production/Preview values live in Project → Settings →
# Environment Variables (BLOB_* are auto-injected by the store connection).

# base64 -i sa-key.json | tr -d '\n'  (Service Account → Keys → JSON)
GOOGLE_SA_JSON_B64=
# From the Drive folder URL: drive.google.com/drive/folders/<THIS>
GOOGLE_DRIVE_FOLDER_ID=
# Blob store → copy token, or: vercel env pull /tmp/vercel-env (needs
# Development connected). Auto-provided on Vercel when store is connected.
BLOB_READ_WRITE_TOKEN=
BLOB_QUOTA_MB=500
# python3 -c "import secrets; print(secrets.token_urlsafe(32))"
FEED_SECRET_TOKEN=
PODCAST_TITLE=My Garmin Podcasts
# Local dev URL here; production URL in Vercel env vars.
PODCAST_BASE_URL=http://localhost:4000
# Google Cloud → Credentials → OAuth 2.0 Web Application client.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Comma-separated; must also be OAuth consent-screen test users.
ALLOWED_EMAILS=
# python3 -c "import secrets; print(secrets.token_hex(32))"
SESSION_SECRET_KEY=
